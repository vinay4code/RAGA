# Enterprise Documentation Q&A Assistant Configuration

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# LLM Provider Configuration: 'gemini', 'openai', or 'local'
# If keys are not provided, system operates in 'local' grounded synthesis mode (offline mode).
LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# Embeddings & Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.35
HYBRID_SEMANTIC_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4

# Paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/vector_store/chroma
DATABASE_URL=sqlite:///./data/metadata.db
